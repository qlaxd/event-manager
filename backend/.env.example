# Application Settings
APP_NAME="UCC Event Manager"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Settings
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Security Settings
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# JWT Keys (Generate these for production)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ucc_events
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# Redis Settings (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ucc-event-manager.com
SMTP_FROM_NAME="UCC Event Manager"
SMTP_TLS=true

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=900  # 15 minutes
RATE_LIMIT_PASSWORD_RESET_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600  # 1 hour
RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_WINDOW=3600  # 1 hour

# MFA Settings
MFA_ISSUER_NAME="UCC Event Manager"
MFA_BACKUP_CODES_COUNT=8
MFA_TIME_WINDOW=1

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_BCRYPT_ROUNDS=12

# Session Settings
SESSION_LIFETIME_SECONDS=86400  # 24 hours
MAX_SESSIONS_PER_USER=5

# Rasa Chatbot Settings
RASA_URL=http://localhost:5005
RASA_TOKEN=optional-rasa-token

# Twilio Settings (for voice helpdesk - optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring
SENTRY_DSN=optional-sentry-dsn
PROMETHEUS_ENABLED=true

# Admin Settings
ADMIN_EMAIL=admin@ucc-event-manager.com
ADMIN_API_KEY=generate-secure-admin-api-key 