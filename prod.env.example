# UCC Event Manager Production Environment Variables
# IMPORTANT: This is just an example file. In production:
# 1. Don't use .env files - use a secure secrets manager
# 2. Generate strong random values for all secrets
# 3. Store JWT keys securely

# Core Settings
ENVIRONMENT=production
SECRET_KEY=replace_with_very_long_random_string
ADMIN_API_KEY=replace_with_very_long_random_string
DEBUG=false

# JWT Authentication
ALGORITHM=RS256
# These should be loaded from secure storage in production, not env vars
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Database
POSTGRES_USER=ucc_event_manager
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=ucc_event_manager_prod
DATABASE_URL=postgresql://ucc_event_manager:replace_with_strong_random_password@postgres:5432/ucc_event_manager_prod

# Redis
REDIS_PASSWORD=replace_with_strong_random_password
REDIS_URL=redis://:replace_with_strong_random_password@redis:6379/0

# Frontend
FRONTEND_API_URL=https://api.ucc-event-manager.com

# Rasa & AI Settings
OLLAMA_MODEL=llama2
OLLAMA_API_URL=http://ollama:11434
RASA_API_URL=http://rasa:5005

# Email Settings
SMTP_SERVER=smtp.provider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@ucc-event-manager.com

# Security Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
MFA_ISSUER_NAME=UCC_Event_Manager
MFA_TIME_WINDOW=1
MFA_BACKUP_CODES_COUNT=8 